---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us & Newsroom Directory | Hollywood Time"
  description="Contact the Hollywood Time editorial newsroom, submit news tips, request corrections, or pitch film and television features."
>
  <div class="max-w-4xl mx-auto py-8">
    <nav class="text-xs text-zinc-500 uppercase tracking-wider mb-6">
      <a href="/" class="hover:text-black">Home</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 font-bold">Contact</span>
    </nav>

    <header class="border-b-2 border-zinc-950 pb-6 mb-10">
      <span class="text-xs font-bold uppercase tracking-widest text-red-600 block mb-2">Get In Touch</span>
      <h1 class="text-4xl sm:text-5xl font-black font-headline tracking-tight uppercase text-zinc-950">
        Contact & Newsroom
      </h1>
      <p class="text-lg font-serif text-zinc-600 mt-3 leading-relaxed">
        Connect directly with our Los Angeles newsroom, submit confidential scoops, or reach our standards desk.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      <!-- Left Column: Department Contacts (5 cols) -->
      <div class="md:col-span-5 space-y-6">
        <div class="p-5 bg-zinc-50 border border-zinc-200 rounded-sm space-y-2">
          <h2 class="text-xs font-bold uppercase tracking-widest text-red-600">Newsroom & Pitching</h2>
          <p class="text-xs text-zinc-600">To pitch breaking news, review screeners, festival dispatches, or talent interviews:</p>
          <a href="mailto:newsroom@hollywoodtime.com" class="text-sm font-bold text-zinc-950 hover:underline block">
            newsroom@hollywoodtime.com
          </a>
        </div>

        <div class="p-5 bg-zinc-50 border border-zinc-200 rounded-sm space-y-2">
          <h2 class="text-xs font-bold uppercase tracking-widest text-red-600">Corrections & Standards</h2>
          <p class="text-xs text-zinc-600">To report a factual inaccuracy, broken link, or attribution question:</p>
          <a href="mailto:corrections@hollywoodtime.com" class="text-sm font-bold text-zinc-950 hover:underline block">
            corrections@hollywoodtime.com
          </a>
        </div>

        <div class="p-5 bg-zinc-50 border border-zinc-200 rounded-sm space-y-2">
          <h2 class="text-xs font-bold uppercase tracking-widest text-red-600">Advertising & Partnerships</h2>
          <p class="text-xs text-zinc-600">For brand partnerships, podcast sponsorships, and advertising slates:</p>
          <a href="mailto:partnerships@hollywoodtime.com" class="text-sm font-bold text-zinc-950 hover:underline block">
            partnerships@hollywoodtime.com
          </a>
        </div>

        <div class="pt-2 text-xs text-zinc-500">
          <p class="font-bold text-zinc-800 uppercase tracking-wider mb-1">Newsroom Location</p>
          <p>Hollywood Time Media LLC</p>
          <p>Sunset Boulevard & Vine Street</p>
          <p>Los Angeles, CA 90028</p>
        </div>
      </div>

      <!-- Right Column: Interactive Contact Form (7 cols) -->
      <div class="md:col-span-7 bg-white border border-zinc-200 p-6 rounded-sm shadow-sm">
        <h2 class="text-xl font-serif font-black text-zinc-950 mb-1">Send a Message or News Tip</h2>
        <p class="text-xs text-zinc-500 mb-6">Your message will be routed directly to the appropriate editor.</p>

        <form id="contact-form" class="space-y-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1">Full Name</label>
            <input
              type="text"
              name="name"
              required
              placeholder="e.g. Jane Doe"
              class="w-full px-3 py-2 text-sm border border-zinc-300 rounded-sm focus:outline-none focus:border-red-600"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1">Email Address</label>
            <input
              type="email"
              name="email"
              required
              placeholder="jane@example.com"
              class="w-full px-3 py-2 text-sm border border-zinc-300 rounded-sm focus:outline-none focus:border-red-600"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1">Department</label>
            <select
              name="department"
              class="w-full px-3 py-2 text-sm border border-zinc-300 rounded-sm focus:outline-none focus:border-red-600"
            >
              <option value="newsroom">Newsroom / Editorial Pitch</option>
              <option value="corrections">Corrections & Factual Inaccuracy</option>
              <option value="reviews">Film & Television Review Request</option>
              <option value="press">Press & PR Inquiry</option>
              <option value="other">General Inquiry</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1">Message or Tip Details</label>
            <textarea
              name="message"
              rows="5"
              required
              placeholder="Provide full details or context here..."
              class="w-full px-3 py-2 text-sm border border-zinc-300 rounded-sm focus:outline-none focus:border-red-600"
            ></textarea>
          </div>

          <button
            type="submit"
            id="btn-submit"
            class="w-full py-2.5 bg-zinc-950 hover:bg-red-600 text-white font-bold text-xs uppercase tracking-wider rounded-sm transition duration-200 cursor-pointer"
          >
            Submit Message
          </button>
        </form>

        <div id="contact-success" class="hidden mt-4 p-4 bg-emerald-50 border border-emerald-300 text-emerald-900 text-xs rounded-sm">
          <strong>Thank you!</strong> Your message has been transmitted to our editorial desk. If your pitch meets our immediate editorial calendar, an editor will be in contact.
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const successMsg = document.getElementById('contact-success');
    const btn = document.getElementById('btn-submit');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Transmitting...';

      setTimeout(() => {
        form.reset();
        btn.disabled = false;
        btn.textContent = 'Submit Message';
        successMsg?.classList.remove('hidden');
      }, 700);
    });
  </script>
</Layout>
