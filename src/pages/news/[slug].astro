---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import VerifiedBadge from '../../components/VerifiedBadge.astro';
import AdBanner from '../../components/AdBanner.astro';
import { getPostBySlug, getRelatedPosts } from '../../lib/db';
import { getAuthorBySlug, getAuthorForCategory } from '../../lib/authors';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

const db = (Astro.locals as any)?.runtime?.env?.DB;
const post = await getPostBySlug(slug, db);

if (!post) {
  return Astro.redirect('/');
}

// Retrieve verified author profile
const authorProfile = (post.author.slug && getAuthorBySlug(post.author.slug)) || getAuthorForCategory(post.category);

// Get exactly latest 3 related posts from same category
const relatedPosts = await getRelatedPosts(post.category, post.slug, 3, db);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  hour: 'numeric',
  minute: 'numeric',
  timeZoneName: 'short',
}).format(new Date(post.publishedAt));

const currentUrl = `https://www.hollywoodtime.com/news/${post.slug}`;
---

<Layout
  title={`${post.title} | Hollywood Time`}
  description={post.excerpt}
  currentCategory={post.category}
  post={post}
  image={post.featuredImage}
>
  <article class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-gray-500 uppercase tracking-wider mb-4">
      <a href="/" class="hover:text-black transition">Home</a>
      <span>/</span>
      <a href={`/${post.category}`} class="text-hollywood-red font-bold hover:underline">
        {post.categoryLabel}
      </a>
      <span>/</span>
      <span class="truncate max-w-[200px] sm:max-w-xs text-gray-400">{post.title}</span>
    </nav>

    <!-- Category Pill & Headline -->
    <div class="space-y-4 mb-6">
      {post.badge && (
        <span class="inline-block px-3 py-1 text-xs font-black uppercase tracking-widest bg-hollywood-red text-white">
          {post.badge}
        </span>
      )}

      <h1 id="article-headline" class="text-2xl sm:text-4xl md:text-[44px] font-serif font-bold text-zinc-950 leading-[1.2] tracking-[-0.015em]">
        {post.title}
      </h1>

      <p class="article-lead text-base sm:text-lg text-zinc-600 font-serif leading-relaxed font-normal">
        {post.subtitle}
      </p>
    </div>

    <!-- Top AdSlot (Google AdSense Leaderboard) -->
    <AdBanner slotType="leaderboard" />

    <!-- Byline & Publish Date -->
    <div class="flex flex-wrap items-center justify-between border-t border-b border-gray-200 py-3 mb-8 gap-4 text-xs">
      <div class="flex items-center space-x-3">
        <a href={`/author/${authorProfile.slug}`} class="block flex-shrink-0">
          <img
            src={authorProfile.avatar}
            alt={authorProfile.name}
            class="w-10 h-10 rounded-full object-cover border border-zinc-200"
          />
        </a>
        <div>
          <div class="flex items-center space-x-2">
            <a
              href={`/author/${authorProfile.slug}`}
              class="font-bold text-zinc-950 hover:text-red-600 transition"
            >
              By {authorProfile.name}
            </a>
            <VerifiedBadge size="sm" />
          </div>
          <p class="text-zinc-500 text-[11px]">{authorProfile.role}</p>
        </div>
      </div>

      <div class="flex items-center space-x-4 text-gray-500">
        <time datetime={post.publishedAt} class="font-sans text-xs text-zinc-500">
          {formattedDate}
        </time>
        <span>•</span>
        <span class="uppercase tracking-wider font-semibold text-zinc-500">{post.readingTimeMinutes} MIN READ</span>
      </div>
    </div>

    <!-- Featured Image & Caption (10% smaller, rounded corners) -->
    <figure class="mb-10 max-w-3xl mx-auto">
      <div class="overflow-hidden bg-gray-100 rounded-xl shadow-xs">
        <img
          src={post.featuredImage}
          alt={post.title}
          class="w-full h-auto object-cover max-h-[460px]"
        />
      </div>
      {(post.imageCaption || post.imageCredit) && (
        <figcaption class="mt-2 text-xs text-gray-500 flex flex-wrap items-center justify-between gap-2 border-b border-gray-100 pb-2">
          <span>{post.imageCaption}</span>
          <span class="font-mono text-[11px] text-gray-400">CREDIT: {post.imageCredit}</span>
        </figcaption>
      )}
    </figure>

    <!-- Social Share Strip -->
    <div class="flex items-center justify-between py-3 mb-8 border-y border-gray-100 text-xs">
      <span class="font-bold uppercase tracking-wider text-gray-600">Share Story</span>
      <div class="flex items-center space-x-2">
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(currentUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 bg-black text-white font-bold rounded-sm hover:bg-gray-800 transition"
        >
          𝕏 Post
        </a>
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 bg-[#1877f2] text-white font-bold rounded-sm hover:opacity-90 transition"
        >
          Facebook
        </a>
        <button
          onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!');"
          class="px-3 py-1.5 bg-gray-100 text-gray-800 border border-gray-300 font-bold rounded-sm hover:bg-gray-200 transition"
        >
          Copy Link
        </button>
      </div>
    </div>

    <!-- Article Content (Editorial Human Typography) -->
    <div class="article-body prose prose-lg max-w-none text-zinc-900 font-sans leading-relaxed space-y-6
      [&>p.lead]:text-xl sm:[&>p.lead]:text-2xl [&>p.lead]:font-serif [&>p.lead]:leading-relaxed [&>p.lead]:text-zinc-950 [&>p.lead]:first-letter:text-6xl [&>p.lead]:first-letter:font-serif [&>p.lead]:first-letter:font-bold [&>p.lead]:first-letter:float-left [&>p.lead]:first-letter:mr-3 [&>p.lead]:first-letter:leading-none [&>p.lead]:first-letter:text-red-600
      [&>h2]:text-2xl sm:[&>h2]:text-3xl [&>h2]:font-serif [&>h2]:font-bold [&>h2]:text-zinc-950 [&>h2]:pt-8 [&>h2]:pb-2 [&>h2]:border-b [&>h2]:border-zinc-200
      [&>p]:text-base sm:[&>p]:text-lg [&>p]:text-zinc-800 [&>p]:leading-relaxed
      [&>blockquote]:border-l-4 [&>blockquote]:border-red-600 [&>blockquote]:pl-6 [&>blockquote]:py-3 [&>blockquote]:italic [&>blockquote]:text-xl sm:[&>blockquote]:text-2xl [&>blockquote]:font-serif [&>blockquote]:my-8 [&>blockquote]:bg-zinc-50 [&>blockquote]:rounded-r-sm [&>blockquote]:text-zinc-900
      [&>blockquote>footer]:block [&>blockquote>footer]:text-xs [&>blockquote>footer]:font-sans [&>blockquote>footer]:font-semibold [&>blockquote>footer]:uppercase [&>blockquote>footer]:tracking-wider [&>blockquote>footer]:text-zinc-500 [&>blockquote>footer]:mt-3 [&>blockquote>footer]:not-italic">
      <Fragment set:html={post.content} />
    </div>

    <!-- High-Yield In-Article Ad Slot -->
    <AdBanner slotType="in-article" />

    <!-- Rich Author Profile Card -->
    <div class="mt-10 p-6 bg-zinc-50 border border-zinc-200 rounded-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-sm">
      <div class="flex items-start space-x-4">
        <a href={`/author/${authorProfile.slug}`} class="block flex-shrink-0">
          <img
            src={authorProfile.avatar}
            alt={authorProfile.name}
            class="w-16 h-16 rounded-full object-cover border-2 border-white shadow-sm"
          />
        </a>
        <div class="space-y-1">
          <div class="flex items-center space-x-2">
            <a href={`/author/${authorProfile.slug}`} class="text-base font-bold text-zinc-950 uppercase tracking-wider hover:text-red-600 transition">
              {authorProfile.name}
            </a>
            <VerifiedBadge size="sm" />
          </div>
          <p class="text-xs font-semibold text-red-600">{authorProfile.role}</p>
          <p class="text-xs text-zinc-600 leading-relaxed max-w-xl">
            {authorProfile.bio}
          </p>
        </div>
      </div>

      <div class="flex-shrink-0 self-end sm:self-center">
        <a
          href={`/author/${authorProfile.slug}`}
          class="inline-flex items-center px-3 py-1.5 bg-white border border-zinc-300 hover:border-red-600 text-zinc-800 hover:text-red-600 text-xs font-bold uppercase tracking-wider rounded-sm transition shadow-sm"
        >
          View Columnist Beat →
        </a>
      </div>
    </div>

    <!-- Story Tags -->
    {post.tags && post.tags.length > 0 && (
      <div class="pt-8 mt-8 border-t border-gray-200">
        <span class="text-xs font-bold uppercase tracking-widest text-gray-500 block mb-3">
          Filed Under
        </span>
        <div class="flex flex-wrap gap-2">
          {post.tags.map((tag) => (
            <span class="px-2.5 py-1 text-xs bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium rounded-sm border border-gray-200">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Editorial Integrity & Corrections Note -->
    <div class="mt-8 pt-6 border-t border-zinc-200 text-xs text-zinc-500 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div class="flex items-center space-x-2">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="font-medium text-zinc-700">Hollywood Time Newsroom • Verified Editorial</span>
      </div>
      <div class="flex items-center space-x-4">
        <a href="/editorial-policy" class="hover:text-black underline">Editorial Policy</a>
        <span class="text-zinc-300">•</span>
        <a href="/contact" class="hover:text-black underline">Report Correction</a>
      </div>
    </div>

    <!-- Related Stories: Exactly Latest 3 Posts from Same Category -->
    {relatedPosts.length > 0 && (
      <section class="mt-16 pt-10 border-t-4 border-black">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl sm:text-2xl font-black font-headline uppercase tracking-wider text-black flex items-center gap-2">
            <span class="w-2.5 h-5 bg-hollywood-red"></span>
            More In {post.categoryLabel}
          </h2>
          <a
            href={`/${post.category}`}
            class="text-xs font-bold uppercase tracking-wider text-hollywood-red hover:underline"
          >
            View All {post.categoryLabel} →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPosts.map((relPost) => (
            <ArticleCard post={relPost} variant="standard" />
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
