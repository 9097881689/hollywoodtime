---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts, getIndexLogs } from '../../lib/db';
import { DEFAULT_FEED_SOURCES } from '../../lib/feeds';

const posts = await getAllPosts();
const logs = await getIndexLogs();
---

<Layout
  title="Hollywood Time Control Hub | Auto-Ingestion & Google Search Console Indexing"
  description="Manage RSS feeds, trigger AI rewriting, monitor Google News indexing status, and manage Cloudflare edge sync."
>
  <div class="max-w-6xl mx-auto py-4">
    <!-- Header banner -->
    <div class="bg-black text-white p-6 rounded-sm mb-8 border-l-4 border-hollywood-red flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-emerald-400">Live Ingestion & Indexing Engine</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black font-headline tracking-wide uppercase mt-1">
          Hollywood Time Operations Hub
        </h1>
        <p class="text-xs text-gray-400 font-serif mt-1">
          Automated multi-source monitor, AI news rewriter, and Google Indexing API publisher.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <button
          id="btn-sync-now"
          class="px-5 py-2.5 bg-hollywood-red hover:bg-red-700 text-white font-bold text-xs uppercase tracking-wider rounded-sm shadow-md transition flex items-center gap-2 cursor-pointer"
        >
          <span id="sync-spinner" class="hidden animate-spin">⟳</span>
          <span>⚡ Sync & Auto-Rewrite Now</span>
        </button>
      </div>
    </div>

    <!-- Live Sync Alert Container -->
    <div id="sync-alert" class="hidden mb-8 p-4 rounded-sm border text-xs"></div>

    <!-- Feed Sources Grid -->
    <section class="mb-10">
      <div class="flex items-center justify-between border-b-2 border-black pb-2 mb-4">
        <h2 class="text-base font-black font-headline uppercase tracking-wider text-black">
          Monitored Sources (4 Feeds)
        </h2>
        <span class="text-xs font-mono text-gray-500">Auto-Polling Active</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {DEFAULT_FEED_SOURCES.map((src) => (
          <div class="border border-gray-200 bg-white p-4 rounded-sm shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[11px] mb-2">
                <span class="font-bold text-hollywood-red uppercase tracking-wider">{src.type.toUpperCase()}</span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">ACTIVE</span>
              </div>
              <h3 class="text-sm font-bold text-black font-serif line-clamp-2 mb-1">{src.name}</h3>
              <p class="text-[11px] text-gray-500 truncate font-mono">{src.url}</p>
            </div>
            <div class="mt-3 pt-2 border-t border-gray-100 flex items-center justify-between text-[10px] text-gray-400">
              <span>Category: {src.categoryDefault}</span>
              <a href={src.url} target="_blank" class="hover:text-black font-bold">Inspect ↗</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Google Search Console & Indexing Section -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
      <!-- Left: Manual Indexing Submitter -->
      <div class="lg:col-span-5 bg-gray-50 border border-gray-200 p-5 rounded-sm">
        <div class="border-b border-gray-200 pb-2 mb-4">
          <h2 class="text-sm font-black font-headline uppercase tracking-wider text-black">
            Google Indexing API Trigger
          </h2>
          <p class="text-xs text-gray-500 font-serif">Instant URL notification for Googlebot crawl</p>
        </div>

        <form id="form-index-url" class="space-y-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Article URL to Index
            </label>
            <input
              type="url"
              id="input-index-url"
              placeholder="https://www.hollywoodtime.com/news/article-slug"
              required
              class="w-full px-3 py-2 text-xs border border-gray-300 rounded-sm focus:outline-none focus:border-hollywood-red font-mono"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Google Cloud Service Account JSON (Optional)
            </label>
            <textarea
              id="input-sa-json"
              rows="3"
              placeholder='{"type": "service_account", "client_email": "...", "private_key": "..."}'
              class="w-full px-3 py-2 text-[11px] border border-gray-300 rounded-sm font-mono focus:outline-none focus:border-hollywood-red"
            ></textarea>
            <p class="text-[10px] text-gray-500 mt-1">
              If omitted, simulated notification & Google News sitemap ping are executed automatically.
            </p>
          </div>

          <button
            type="submit"
            class="w-full py-2 bg-black hover:bg-gray-800 text-white font-bold text-xs uppercase tracking-wider rounded-sm transition cursor-pointer"
          >
            Submit URL to Google Indexing
          </button>
        </form>
      </div>

      <!-- Right: Live Indexing Audit Logs -->
      <div class="lg:col-span-7 bg-white border border-gray-200 p-5 rounded-sm">
        <div class="flex items-center justify-between border-b border-gray-200 pb-2 mb-4">
          <h2 class="text-sm font-black font-headline uppercase tracking-wider text-black">
            Google Indexing Activity Log
          </h2>
          <span class="text-[11px] font-mono text-gray-400">Total: {logs.length}</span>
        </div>

        <div class="overflow-y-auto max-h-[300px] divide-y divide-gray-100 text-xs">
          {logs.map((log) => (
            <div class="py-2.5 flex items-start justify-between gap-3">
              <div class="space-y-0.5">
                <div class="flex items-center gap-2">
                  <span class={`px-1.5 py-0.5 rounded text-[10px] font-bold uppercase font-mono ${
                    log.status === 'SUCCESS' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
                  }`}>
                    {log.status} ({log.statusCode || 200})
                  </span>
                  <span class="font-mono text-gray-400 text-[10px]">{log.action}</span>
                </div>
                <p class="font-mono text-black font-semibold truncate max-w-sm sm:max-w-md">{log.url}</p>
                <p class="text-[11px] text-gray-500">{log.responseMessage}</p>
              </div>
              <time class="text-[10px] text-gray-400 whitespace-nowrap font-mono">
                {new Date(log.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}
              </time>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Published Articles Table -->
    <section class="bg-white border border-gray-200 p-5 rounded-sm">
      <div class="flex items-center justify-between border-b-2 border-black pb-2 mb-4">
        <div>
          <h2 class="text-base font-black font-headline uppercase tracking-wider text-black">
            Published Editorial Stories
          </h2>
          <p class="text-xs text-gray-500">Every category strictly displays its latest 3 posts on the homepage.</p>
        </div>
        <span class="text-xs font-mono font-bold text-hollywood-red">{posts.length} Total Posts</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-gray-50 text-gray-600 uppercase font-bold text-[10px] tracking-wider border-b border-gray-200">
            <tr>
              <th class="py-2 px-3">Story Title</th>
              <th class="py-2 px-3">Category</th>
              <th class="py-2 px-3">Byline</th>
              <th class="py-2 px-3">Published</th>
              <th class="py-2 px-3">Google Status</th>
              <th class="py-2 px-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {posts.map((post) => (
              <tr class="hover:bg-gray-50 transition">
                <td class="py-2.5 px-3 font-serif font-bold text-black max-w-md">
                  <a href={`/news/${post.slug}`} class="hover:text-hollywood-red transition line-clamp-1">
                    {post.title}
                  </a>
                </td>
                <td class="py-2.5 px-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-gray-100 text-gray-700">
                    {post.categoryLabel}
                  </span>
                </td>
                <td class="py-2.5 px-3 text-gray-600">{post.author.name}</td>
                <td class="py-2.5 px-3 font-mono text-[11px] text-gray-500">
                  {new Date(post.publishedAt).toLocaleDateString()}
                </td>
                <td class="py-2.5 px-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
                    ✓ Indexed
                  </span>
                </td>
                <td class="py-2.5 px-3 text-right">
                  <a
                    href={`/news/${post.slug}`}
                    target="_blank"
                    class="text-hollywood-red font-bold hover:underline"
                  >
                    View Story ↗
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <!-- Interactive JavaScript for Live Triggering -->
  <script is:inline>
    const btnSync = document.getElementById('btn-sync-now');
    const syncSpinner = document.getElementById('sync-spinner');
    const syncAlert = document.getElementById('sync-alert');
    const formIndex = document.getElementById('form-index-url');
    const inputUrl = document.getElementById('input-index-url');
    const inputSa = document.getElementById('input-sa-json');

    // Restore saved SA json if available
    const savedSa = localStorage.getItem('ht_service_account');
    if (savedSa && inputSa) inputSa.value = savedSa;

    btnSync?.addEventListener('click', async () => {
      btnSync.disabled = true;
      syncSpinner?.classList.remove('hidden');
      syncAlert?.classList.add('hidden');

      try {
        const res = await fetch('/api/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            serviceAccountJson: inputSa?.value || undefined,
          }),
        });

        const data = await res.json();
        syncAlert?.classList.remove('hidden');

        if (data.success) {
          syncAlert.className = 'mb-8 p-4 rounded-sm border text-xs bg-emerald-50 border-emerald-300 text-emerald-900';
          syncAlert.innerHTML = `
            <strong>✓ Sync Succeeded!</strong> ${data.message}
            <div class="mt-2 text-[11px]">
              ${data.createdPosts && data.createdPosts.length > 0
                ? `Created and indexed: ${data.createdPosts.map(p => `<strong>${p.title}</strong> (${p.category})`).join(', ')}`
                : 'All feeds up to date. Latest 3 posts per category maintained.'}
            </div>
          `;
          setTimeout(() => window.location.reload(), 2500);
        } else {
          syncAlert.className = 'mb-8 p-4 rounded-sm border text-xs bg-red-50 border-red-300 text-red-900';
          syncAlert.textContent = `Sync Error: ${data.error || 'Unknown error'}`;
        }
      } catch (err) {
        syncAlert?.classList.remove('hidden');
        syncAlert.className = 'mb-8 p-4 rounded-sm border text-xs bg-red-50 border-red-300 text-red-900';
        syncAlert.textContent = `Network / Sync Error: ${err.message}`;
      } finally {
        btnSync.disabled = false;
        syncSpinner?.classList.add('hidden');
      }
    });

    formIndex?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const url = inputUrl?.value;
      if (!url) return;

      if (inputSa?.value) {
        localStorage.setItem('ht_service_account', inputSa.value);
      }

      try {
        const res = await fetch('/api/index-url', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            url,
            serviceAccountJson: inputSa?.value || undefined,
          }),
        });

        const data = await res.json();
        alert(`Google Indexing Response: ${data.message || JSON.stringify(data)}`);
        window.location.reload();
      } catch (err) {
        alert(`Submission Error: ${err.message}`);
      }
    });
  </script>
</Layout>
