---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts, getIndexLogs } from '../../lib/db';
import { DEFAULT_FEED_SOURCES } from '../../lib/feeds';
import { AUTH_COOKIE_NAME, isAuthenticated } from '../../lib/auth';

// Enforce authentication
const authCookie = Astro.cookies.get(AUTH_COOKIE_NAME)?.value;
if (!isAuthenticated(authCookie)) {
  return Astro.redirect('/admin/login');
}

const db = (Astro.locals as any)?.runtime?.env?.DB;
const posts = await getAllPosts(db);
const logs = await getIndexLogs();
---

<Layout
  title="Hollywood Time Control Hub | Operations & Editorial Admin"
  description="Manage RSS feeds, trigger AI rewriting, monitor Google News indexing status, and manage Cloudflare edge sync."
>
  <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6">
    
    <!-- Top Operations Banner -->
    <div class="bg-zinc-950 text-white p-6 sm:p-8 rounded-xl mb-8 border-l-4 border-hollywood-red shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <div class="flex items-center gap-3">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
          </span>
          <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-bold">
            Live Ingestion & Edge D1 SQLite Connected
          </span>
          <span class="text-xs text-zinc-500">•</span>
          <span class="text-xs font-mono text-zinc-400">User: <strong class="text-zinc-200">admin</strong></span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black font-headline tracking-wide uppercase mt-2">
          Hollywood Time Operations Hub
        </h1>
        <p class="text-xs sm:text-sm text-zinc-400 font-sans mt-1">
          Automated multi-source monitor, AI news rewriter, Google Indexing API publisher, and Cloudflare D1 editor.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button
          id="btn-sync-now"
          class="px-5 py-2.5 bg-hollywood-red hover:bg-red-700 text-white font-bold text-xs uppercase tracking-wider rounded-lg shadow-md transition flex items-center gap-2 cursor-pointer active:scale-95"
        >
          <span id="sync-spinner" class="hidden animate-spin">⟳</span>
          <span>⚡ Sync & Auto-Rewrite Now</span>
        </button>

        <a
          href="#manual-publish-section"
          class="px-4 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-bold text-xs uppercase tracking-wider rounded-lg transition"
        >
          ✍️ Write New Story
        </a>

        <a
          href="/admin/logout"
          class="px-3.5 py-2.5 bg-zinc-900 hover:bg-red-950/80 text-zinc-400 hover:text-red-400 font-bold text-xs uppercase tracking-wider rounded-lg border border-zinc-800 transition"
          title="Sign out of Admin Session"
        >
          Logout ⇥
        </a>
      </div>
    </div>

    <!-- Live Sync Alert Container -->
    <div id="sync-alert" class="hidden mb-8 p-4 rounded-lg border text-xs transition duration-200"></div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="bg-white p-4 rounded-xl border border-zinc-200 shadow-xs">
        <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 font-semibold">Total Posts</div>
        <div class="text-2xl font-serif font-black text-zinc-950 mt-1">{posts.length}</div>
        <div class="text-[10px] text-emerald-600 font-semibold mt-0.5">✓ D1 SQLite Synced</div>
      </div>
      <div class="bg-white p-4 rounded-xl border border-zinc-200 shadow-xs">
        <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 font-semibold">Categories</div>
        <div class="text-2xl font-serif font-black text-zinc-950 mt-1">7</div>
        <div class="text-[10px] text-zinc-500 font-semibold mt-0.5">Latest 3 strictly per category</div>
      </div>
      <div class="bg-white p-4 rounded-xl border border-zinc-200 shadow-xs">
        <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 font-semibold">Auto-Post Cycle</div>
        <div class="text-2xl font-serif font-black text-zinc-950 mt-1">5 Min</div>
        <div class="text-[10px] text-emerald-600 font-semibold mt-0.5">Crontab & Action Active</div>
      </div>
      <div class="bg-white p-4 rounded-xl border border-zinc-200 shadow-xs">
        <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 font-semibold">Verified Byline</div>
        <div class="text-2xl font-serif font-black text-zinc-950 mt-1">4 Staff</div>
        <div class="text-[10px] text-blue-600 font-semibold mt-0.5">✓ Verified Tick Enabled</div>
      </div>
    </div>

    <!-- AI News Fetch & Instant Rewriter Section -->
    <section id="ai-fetch-section" class="bg-gradient-to-br from-zinc-900 to-zinc-950 text-white border border-zinc-800 p-6 sm:p-7 rounded-xl shadow-md mb-8">
      <div class="border-b border-zinc-800 pb-3 mb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 bg-red-600/30 text-red-400 border border-red-500/40 rounded text-[10px] font-black uppercase tracking-widest">
              AI FETCH ENGINE
            </span>
            <span class="text-xs text-zinc-400 font-mono">Gemini & Journalistic Transform</span>
          </div>
          <h2 class="text-lg sm:text-xl font-black font-headline uppercase tracking-wide text-white">
            ⚡ AI News Fetch & Instant Rewriter
          </h2>
          <p class="text-xs text-zinc-400 font-sans mt-0.5">
            Enter any news link (Variety, Deadline, THR, etc.) or breaking topic — AI will fetch and rewrite it into a complete human-style article.
          </p>
        </div>
        <span class="px-2.5 py-1 bg-emerald-500/20 text-emerald-400 text-[10px] font-bold uppercase rounded-md border border-emerald-500/30 w-fit">
          ✓ Active
        </span>
      </div>

      <div class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
          <div class="md:col-span-8">
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-1.5">
              News URL or Breaking Topic *
            </label>
            <input
              type="text"
              id="ai-fetch-input"
              placeholder="e.g. https://deadline.com/... OR 'Christopher Nolan announces new 2026 film'"
              class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-zinc-800/90 border border-zinc-700 rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 font-mono"
            />
          </div>

          <div class="md:col-span-4">
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-1.5">
              Category Override
            </label>
            <select
              id="ai-fetch-category"
              class="w-full px-3 py-2.5 text-xs sm:text-sm bg-zinc-800 border border-zinc-700 rounded-lg text-white focus:outline-none focus:border-red-500 font-sans"
            >
              <option value="">Auto-Detect Category</option>
              <option value="movies">Movies</option>
              <option value="tv">TV</option>
              <option value="music">Music</option>
              <option value="awards">Awards</option>
              <option value="business">Business</option>
              <option value="style">Style</option>
              <option value="culture">Culture</option>
            </select>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-zinc-800/80">
          <div class="text-[11px] text-zinc-400 font-mono flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Supports direct URLs & raw topics</span>
          </div>

          <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            <button
              type="button"
              id="btn-ai-fill"
              class="px-4 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-bold text-xs uppercase tracking-wider rounded-lg border border-zinc-700 transition flex items-center gap-2 cursor-pointer active:scale-95"
            >
              <span id="spinner-ai-fill" class="hidden animate-spin">⟳</span>
              <span>📝 AI Fetch & Fill Form</span>
            </button>

            <button
              type="button"
              id="btn-ai-autopublish"
              class="px-5 py-2.5 bg-hollywood-red hover:bg-red-700 text-white font-bold text-xs uppercase tracking-wider rounded-lg shadow-md transition flex items-center gap-2 cursor-pointer active:scale-95"
            >
              <span id="spinner-ai-pub" class="hidden animate-spin">⟳</span>
              <span>🚀 AI Fetch & 1-Click Publish Live</span>
            </button>
          </div>
        </div>

        <div id="ai-fetch-alert" class="hidden p-3.5 rounded-lg text-xs font-medium"></div>
      </div>
    </section>

    <!-- Manual Story Publishing Form (Direct to D1) -->
    <section id="manual-publish-section" class="bg-white border border-zinc-200 p-6 rounded-xl shadow-xs mb-10">
      <div class="border-b border-zinc-200 pb-3 mb-5 flex items-center justify-between">
        <div>
          <h2 class="text-base font-black font-headline uppercase tracking-wider text-zinc-950">
            ✍️ Edit & Publish Story (Direct to Cloudflare D1)
          </h2>
          <p class="text-xs text-zinc-500 font-sans">
            Write a custom human-journalism article or review AI-fetched content before saving to D1 SQLite.
          </p>
        </div>
        <span class="px-2.5 py-1 bg-red-50 text-red-700 text-[10px] font-bold uppercase rounded-md border border-red-200">
          Instant Live
        </span>
      </div>

      <form id="form-manual-post" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
          <div class="md:col-span-8">
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1">
              Article Title *
            </label>
            <input
              type="text"
              id="post-title"
              required
              placeholder="e.g. Christopher Nolan Sets Next Epic Feature at Universal"
              class="w-full px-3.5 py-2 text-sm border border-zinc-300 rounded-lg focus:outline-none focus:border-red-600 font-serif"
            />
          </div>

          <div class="md:col-span-4">
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1">
              Category *
            </label>
            <select
              id="post-category"
              required
              class="w-full px-3 py-2 text-sm border border-zinc-300 rounded-lg focus:outline-none focus:border-red-600 bg-white"
            >
              <option value="movies">Movies</option>
              <option value="tv">TV</option>
              <option value="music">Music</option>
              <option value="awards">Awards</option>
              <option value="business">Business</option>
              <option value="style">Style</option>
              <option value="culture">Culture</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
          <div class="md:col-span-6">
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1">
              Featured Image URL
            </label>
            <input
              type="url"
              id="post-image"
              placeholder="https://images.unsplash.com/photo-..."
              class="w-full px-3.5 py-2 text-xs border border-zinc-300 rounded-lg focus:outline-none focus:border-red-600 font-mono"
            />
          </div>

          <div class="md:col-span-6">
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1">
              Author (Title Case with ✓)
            </label>
            <select
              id="post-author"
              class="w-full px-3 py-2 text-sm border border-zinc-300 rounded-lg focus:outline-none focus:border-red-600 bg-white"
            >
              <option value="A.K. Singh">A.K. Singh (Editor-in-Chief)</option>
              <option value="Bidyanand">Bidyanand (Film & TV Critic)</option>
              <option value="S.K. Singh">S.K. Singh (Music & Awards Editor)</option>
              <option value="N.K. Mishra">N.K. Mishra (Style & Culture Correspondent)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1">
            Article Summary / Excerpt *
          </label>
          <input
            type="text"
            id="post-excerpt"
            required
            placeholder="A compelling 2-sentence editorial overview of the breaking story..."
            class="w-full px-3.5 py-2 text-xs border border-zinc-300 rounded-lg focus:outline-none focus:border-red-600"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1">
            Full Editorial Article Content (HTML / Longform) *
          </label>
          <textarea
            id="post-content"
            rows="6"
            required
            placeholder="<p class='lead'>Opening drop cap paragraph...</p><h2>Subheading</h2><p>Analysis paragraph...</p><blockquote>Quote</blockquote>"
            class="w-full px-3.5 py-2.5 text-xs font-mono border border-zinc-300 rounded-lg focus:outline-none focus:border-red-600"
          ></textarea>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button
            type="submit"
            id="btn-publish-submit"
            class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider rounded-lg shadow-sm transition cursor-pointer"
          >
            Publish Live to Cloudflare D1 →
          </button>
        </div>
      </form>
      <div id="manual-post-alert" class="hidden mt-4 p-3 rounded-lg text-xs font-medium"></div>
    </section>

    <!-- Monitored Sources Grid -->
    <section class="mb-10">
      <div class="flex items-center justify-between border-b-2 border-black pb-2 mb-4">
        <h2 class="text-base font-black font-headline uppercase tracking-wider text-black">
          Monitored Sources (4 Feeds)
        </h2>
        <span class="text-xs font-mono text-zinc-500 font-semibold">Auto-Polling Every 5 Minutes</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {DEFAULT_FEED_SOURCES.map((src) => (
          <div class="border border-zinc-200 bg-white p-4 rounded-xl shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[11px] mb-2">
                <span class="font-bold text-hollywood-red uppercase tracking-wider">{src.type.toUpperCase()}</span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">ACTIVE</span>
              </div>
              <h3 class="text-sm font-bold text-zinc-950 font-serif line-clamp-2 mb-1">{src.name}</h3>
              <p class="text-[11px] text-zinc-500 truncate font-mono">{src.url}</p>
            </div>
            <div class="mt-3 pt-2 border-t border-zinc-100 flex items-center justify-between text-[10px] text-zinc-400">
              <span>Category: <strong>{src.categoryDefault}</strong></span>
              <a href={src.url} target="_blank" class="hover:text-black font-bold">Inspect ↗</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Google Search Console & Indexing Section -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
      <!-- Left: Manual Indexing Submitter -->
      <div class="lg:col-span-5 bg-zinc-50 border border-zinc-200 p-5 rounded-xl">
        <div class="border-b border-zinc-200 pb-2 mb-4">
          <h2 class="text-sm font-black font-headline uppercase tracking-wider text-zinc-950">
            Google Indexing API Trigger
          </h2>
          <p class="text-xs text-zinc-500 font-sans">Instant URL notification for Googlebot fast indexing</p>
        </div>

        <form id="form-index-url" class="space-y-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1">
              Article URL to Index
            </label>
            <input
              type="url"
              id="input-index-url"
              placeholder="https://hollywoodtime.pages.dev/news/article-slug"
              required
              class="w-full px-3 py-2 text-xs border border-zinc-300 rounded-lg focus:outline-none focus:border-red-600 font-mono bg-white"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1">
              Google Cloud Service Account JSON (Optional)
            </label>
            <textarea
              id="input-sa-json"
              rows="3"
              placeholder='{"type": "service_account", "client_email": "...", "private_key": "..."}'
              class="w-full px-3 py-2 text-[11px] border border-zinc-300 rounded-lg font-mono focus:outline-none focus:border-red-600 bg-white"
            ></textarea>
            <p class="text-[10px] text-zinc-500 mt-1">
              If omitted, simulated notification & Google News sitemap ping are executed automatically.
            </p>
          </div>

          <button
            type="submit"
            class="w-full py-2.5 bg-zinc-950 hover:bg-zinc-800 text-white font-bold text-xs uppercase tracking-wider rounded-lg transition cursor-pointer"
          >
            Submit URL to Google Indexing
          </button>
        </form>
      </div>

      <!-- Right: Live Indexing Audit Logs -->
      <div class="lg:col-span-7 bg-white border border-zinc-200 p-5 rounded-xl">
        <div class="flex items-center justify-between border-b border-zinc-200 pb-2 mb-4">
          <h2 class="text-sm font-black font-headline uppercase tracking-wider text-zinc-950">
            Google Indexing Activity Log
          </h2>
          <span class="text-[11px] font-mono text-zinc-400">Total: {logs.length}</span>
        </div>

        <div class="overflow-y-auto max-h-[300px] divide-y divide-zinc-100 text-xs">
          {logs.map((log) => (
            <div class="py-2.5 flex items-start justify-between gap-3">
              <div class="space-y-0.5">
                <div class="flex items-center gap-2">
                  <span class={`px-1.5 py-0.5 rounded text-[10px] font-bold uppercase font-mono ${
                    log.status === 'SUCCESS' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
                  }`}>
                    {log.status} ({log.statusCode || 200})
                  </span>
                  <span class="font-mono text-zinc-400 text-[10px]">{log.action}</span>
                </div>
                <p class="font-mono text-zinc-950 font-semibold truncate max-w-sm sm:max-w-md">{log.url}</p>
                <p class="text-[11px] text-zinc-500">{log.responseMessage}</p>
              </div>
              <time class="text-[10px] text-zinc-400 whitespace-nowrap font-mono">
                {new Date(log.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}
              </time>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Published Articles Table -->
    <section class="bg-white border border-zinc-200 p-5 rounded-xl shadow-xs">
      <div class="flex items-center justify-between border-b-2 border-black pb-3 mb-4">
        <div>
          <h2 class="text-base font-black font-headline uppercase tracking-wider text-zinc-950">
            Published Editorial Stories
          </h2>
          <p class="text-xs text-zinc-500">Persisted permanently in Cloudflare D1 SQLite database.</p>
        </div>
        <span class="text-xs font-mono font-bold text-hollywood-red">{posts.length} Total Stories</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-zinc-50 text-zinc-600 uppercase font-bold text-[10px] tracking-wider border-b border-zinc-200">
            <tr>
              <th class="py-2.5 px-3">Story Title</th>
              <th class="py-2.5 px-3">Category</th>
              <th class="py-2.5 px-3">Byline</th>
              <th class="py-2.5 px-3">Published</th>
              <th class="py-2.5 px-3">Google Status</th>
              <th class="py-2.5 px-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            {posts.map((post) => (
              <tr class="hover:bg-zinc-50 transition">
                <td class="py-2.5 px-3 font-serif font-bold text-zinc-950 max-w-md">
                  <a href={`/news/${post.slug}`} target="_blank" class="hover:text-hollywood-red transition line-clamp-1">
                    {post.title}
                  </a>
                </td>
                <td class="py-2.5 px-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-zinc-100 text-zinc-700">
                    {post.categoryLabel}
                  </span>
                </td>
                <td class="py-2.5 px-3 text-zinc-600">
                  <span class="font-medium text-zinc-800 flex items-center gap-1">
                    {post.author.name}
                    <span class="w-3 h-3 rounded-full bg-blue-600 text-white inline-flex items-center justify-center text-[7px] font-black">✓</span>
                  </span>
                </td>
                <td class="py-2.5 px-3 font-mono text-[11px] text-zinc-500">
                  {new Date(post.publishedAt).toLocaleDateString()}
                </td>
                <td class="py-2.5 px-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
                    ✓ Indexed
                  </span>
                </td>
                <td class="py-2.5 px-3 text-right">
                  <a
                    href={`/news/${post.slug}`}
                    target="_blank"
                    class="text-hollywood-red font-bold hover:underline"
                  >
                    View Story ↗
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <!-- Interactive JavaScript for Live Auto-Sync & Manual Story Publishing -->
  <script is:inline>
    const btnSync = document.getElementById('btn-sync-now');
    const syncSpinner = document.getElementById('sync-spinner');
    const syncAlert = document.getElementById('sync-alert');
    const formIndex = document.getElementById('form-index-url');
    const inputUrl = document.getElementById('input-index-url');
    const inputSa = document.getElementById('input-sa-json');
    const formManual = document.getElementById('form-manual-post');
    const manualAlert = document.getElementById('manual-post-alert');

    // Restore saved SA json if available
    const savedSa = localStorage.getItem('ht_service_account');
    if (savedSa && inputSa) inputSa.value = savedSa;

    // 1-Click Sync Trigger
    btnSync?.addEventListener('click', async () => {
      btnSync.disabled = true;
      syncSpinner?.classList.remove('hidden');
      syncAlert?.classList.add('hidden');

      try {
        const res = await fetch('/api/sync', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer hollywoodtime_secret_key_2026'
          },
          body: JSON.stringify({
            serviceAccountJson: inputSa?.value || undefined,
          }),
        });

        const data = await res.json();
        syncAlert?.classList.remove('hidden');

        if (data.success) {
          syncAlert.className = 'mb-8 p-4 rounded-xl border text-xs bg-emerald-50 border-emerald-300 text-emerald-900';
          syncAlert.innerHTML = `
            <strong>✓ Sync Succeeded!</strong> ${data.message}
            <div class="mt-2 text-[11px]">
              ${data.createdPosts && data.createdPosts.length > 0
                ? `Created and indexed: ${data.createdPosts.map(p => `<strong>${p.title}</strong> (${p.category})`).join(', ')}`
                : 'All feeds up to date. Latest 3 posts per category maintained in D1.'}
            </div>
          `;
          setTimeout(() => window.location.reload(), 2000);
        } else {
          syncAlert.className = 'mb-8 p-4 rounded-xl border text-xs bg-red-50 border-red-300 text-red-900';
          syncAlert.textContent = `Sync Error: ${data.error || 'Unknown error'}`;
        }
      } catch (err) {
        syncAlert?.classList.remove('hidden');
        syncAlert.className = 'mb-8 p-4 rounded-xl border text-xs bg-red-50 border-red-300 text-red-900';
        syncAlert.textContent = `Network / Sync Error: ${err.message}`;
      } finally {
        btnSync.disabled = false;
        syncSpinner?.classList.add('hidden');
      }
    });

    // Direct Manual Publishing Form
    formManual?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = document.getElementById('post-title')?.value;
      const category = document.getElementById('post-category')?.value;
      const featuredImage = document.getElementById('post-image')?.value || 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1200&q=80';
      const authorName = document.getElementById('post-author')?.value;
      const excerpt = document.getElementById('post-excerpt')?.value;
      const content = document.getElementById('post-content')?.value;

      if (!title || !category || !content) return;

      const submitBtn = document.getElementById('btn-publish-submit');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Publishing to Cloudflare D1...';
      }

      try {
        const res = await fetch('/api/publish', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer hollywoodtime_secret_key_2026'
          },
          body: JSON.stringify({
            title,
            category,
            featuredImage,
            excerpt,
            content,
            authorName,
            serviceAccountJson: inputSa?.value || undefined
          })
        });

        const data = await res.json();
        manualAlert?.classList.remove('hidden');

        if (data.success) {
          manualAlert.className = 'mt-4 p-3.5 rounded-lg text-xs font-medium bg-emerald-50 border border-emerald-300 text-emerald-900';
          manualAlert.innerHTML = `<strong>✓ Story Published Successfully!</strong> Saved to D1 SQLite database. <a href="${data.url}" target="_blank" class="underline font-bold ml-1">View Story ↗</a>`;
          formManual.reset();
          setTimeout(() => window.location.reload(), 2000);
        } else {
          manualAlert.className = 'mt-4 p-3.5 rounded-lg text-xs font-medium bg-red-50 border border-red-300 text-red-900';
          manualAlert.textContent = `Publishing Error: ${data.error || 'Failed to save to D1.'}`;
        }
      } catch (err) {
        manualAlert?.classList.remove('hidden');
        manualAlert.className = 'mt-4 p-3.5 rounded-lg text-xs font-medium bg-red-50 border border-red-300 text-red-900';
        manualAlert.textContent = `Network Error: ${err.message}`;
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Publish Live to Cloudflare D1 →';
        }
      }
    });

    // Single URL Indexing Form
    formIndex?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const url = inputUrl?.value;
      if (!url) return;

      if (inputSa?.value) {
        localStorage.setItem('ht_service_account', inputSa.value);
      }

      try {
        const res = await fetch('/api/index-url', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            url,
            serviceAccountJson: inputSa?.value || undefined,
          }),
        });

        const data = await res.json();
        alert(`Google Indexing Response: ${data.message || JSON.stringify(data)}`);
        window.location.reload();
      } catch (err) {
        alert(`Submission Error: ${err.message}`);
      }
    });

    // AI Fetch Client Handlers
    const inputAi = document.getElementById('ai-fetch-input');
    const selectAiCat = document.getElementById('ai-fetch-category');
    const btnAiFill = document.getElementById('btn-ai-fill');
    const btnAiAutoPub = document.getElementById('btn-ai-autopublish');
    const spinnerAiFill = document.getElementById('spinner-ai-fill');
    const spinnerAiPub = document.getElementById('spinner-ai-pub');
    const aiAlert = document.getElementById('ai-fetch-alert');

    async function handleAiFetch(autoPublish) {
      const source = inputAi?.value?.trim();
      if (!source) {
        alert('Please enter a news URL or breaking news topic to fetch.');
        inputAi?.focus();
        return;
      }

      const activeBtn = autoPublish ? btnAiAutoPub : btnAiFill;
      const activeSpinner = autoPublish ? spinnerAiPub : spinnerAiFill;

      if (activeBtn) activeBtn.disabled = true;
      if (activeSpinner) activeSpinner.classList.remove('hidden');
      if (aiAlert) aiAlert.classList.add('hidden');

      try {
        const res = await fetch('/api/ai-fetch', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer hollywoodtime_secret_key_2026'
          },
          body: JSON.stringify({
            source,
            category: selectAiCat?.value || undefined,
            autoPublish: Boolean(autoPublish),
            serviceAccountJson: inputSa?.value || undefined
          })
        });

        const data = await res.json();
        if (aiAlert) aiAlert.classList.remove('hidden');

        if (data.success && data.post) {
          if (autoPublish) {
            aiAlert.className = 'p-4 rounded-xl border text-xs bg-emerald-950/80 border-emerald-500/50 text-emerald-200';
            aiAlert.innerHTML = `<strong>✓ AI Fetch & Publish Success!</strong> Live in D1 & submitted to Google. <a href="${data.url}" target="_blank" class="underline font-bold text-white ml-1">View Live Story ↗</a>`;
            setTimeout(() => window.location.reload(), 2000);
          } else {
            // Populate form below
            const p = data.post;
            const titleInput = document.getElementById('post-title');
            const catSelect = document.getElementById('post-category');
            const imgInput = document.getElementById('post-image');
            const authorSelect = document.getElementById('post-author');
            const excerptInput = document.getElementById('post-excerpt');
            const contentInput = document.getElementById('post-content');

            if (titleInput) titleInput.value = p.title || '';
            if (catSelect && p.category) catSelect.value = p.category.toLowerCase();
            if (imgInput) imgInput.value = p.featuredImage || '';
            if (authorSelect && p.author?.name) authorSelect.value = p.author.name;
            if (excerptInput) excerptInput.value = p.excerpt || '';
            if (contentInput) contentInput.value = p.content || '';

            aiAlert.className = 'p-4 rounded-xl border text-xs bg-emerald-950/80 border-emerald-500/50 text-emerald-200';
            aiAlert.innerHTML = `<strong>✓ AI Fetch Complete!</strong> Story populated into the form below. Review or edit, then click Publish.`;

            // Smooth scroll to form
            document.getElementById('manual-publish-section')?.scrollIntoView({ behavior: 'smooth' });
          }
        } else {
          aiAlert.className = 'p-4 rounded-xl border text-xs bg-red-950/80 border-red-500/50 text-red-200';
          aiAlert.textContent = `AI Fetch Error: ${data.error || 'Failed to fetch article.'}`;
        }
      } catch (err) {
        if (aiAlert) {
          aiAlert.classList.remove('hidden');
          aiAlert.className = 'p-4 rounded-xl border text-xs bg-red-950/80 border-red-500/50 text-red-200';
          aiAlert.textContent = `Network / AI Fetch Error: ${err.message}`;
        }
      } finally {
        if (activeBtn) activeBtn.disabled = false;
        if (activeSpinner) activeSpinner.classList.add('hidden');
      }
    }

    btnAiFill?.addEventListener('click', () => handleAiFetch(false));
    btnAiAutoPub?.addEventListener('click', () => handleAiFetch(true));
  </script>
</Layout>
