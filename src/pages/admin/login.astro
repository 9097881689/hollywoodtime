---
import Layout from '../../layouts/Layout.astro';
import { AUTH_COOKIE_NAME, AUTH_TOKEN_VALUE, verifyAdminCredentials, isAuthenticated } from '../../lib/auth';

let errorMessage = '';

// Check if already authenticated
const existingAuth = Astro.cookies.get(AUTH_COOKIE_NAME)?.value;
if (isAuthenticated(existingAuth)) {
  return Astro.redirect('/admin');
}

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const username = formData.get('username')?.toString() || '';
    const password = formData.get('password')?.toString() || '';

    if (verifyAdminCredentials(username, password)) {
      Astro.cookies.set(AUTH_COOKIE_NAME, AUTH_TOKEN_VALUE, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        maxAge: 60 * 60 * 24 * 7, // 7 days
      });
      return Astro.redirect('/admin');
    } else {
      errorMessage = 'Invalid username or password. Please try again.';
    }
  } catch (err: any) {
    errorMessage = err.message || 'An unexpected error occurred during login.';
  }
}
---

<Layout
  title="Admin Login | Hollywood Time Control Center"
  description="Sign in to the Hollywood Time Operations & Management Hub"
>
  <div class="min-h-[70vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-zinc-50">
    <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-[0_4px_20px_rgba(0,0,0,0.06)] border border-gray-200">
      
      <!-- Brand Masthead Header -->
      <div class="text-center">
        <a href="/" class="inline-block">
          <span class="font-serif font-black text-2xl sm:text-3xl tracking-tight text-zinc-950 uppercase">
            Hollywood<span class="text-hollywood-red ml-1.5 text-xl font-sans inline-block">◆</span>Time
          </span>
        </a>
        <div class="mt-2 flex items-center justify-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-zinc-600">
            Control Center & Editorial Hub
          </span>
        </div>
        <h2 class="mt-4 text-xl font-bold font-serif text-zinc-900">
          Sign In to Admin Portal
        </h2>
        <p class="mt-1 text-xs text-zinc-500 font-sans">
          Manage auto-ingestion, D1 database stories, and Google Search Console indexing.
        </p>
      </div>

      <!-- Error Alert -->
      {errorMessage && (
        <div class="p-3.5 bg-red-50 border border-red-200 rounded-lg text-xs text-red-700 font-medium flex items-center gap-2.5">
          <span class="text-red-600 text-base font-bold">⚠️</span>
          <span>{errorMessage}</span>
        </div>
      )}

      <!-- Login Form -->
      <form class="mt-6 space-y-5" method="POST">
        <div>
          <label for="username" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1.5">
            Username / Login ID
          </label>
          <div class="relative">
            <input
              id="username"
              name="username"
              type="text"
              required
              autofocus
              placeholder="e.g. admin"
              class="w-full px-3.5 py-2.5 bg-zinc-50 border border-zinc-300 rounded-lg text-sm text-zinc-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-600/30 focus:border-red-600 transition"
            />
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="password" class="block text-xs font-bold uppercase tracking-wider text-zinc-700">
              Admin Password
            </label>
          </div>
          <div class="relative">
            <input
              id="password"
              name="password"
              type="password"
              required
              placeholder="••••••••••••"
              class="w-full px-3.5 py-2.5 bg-zinc-50 border border-zinc-300 rounded-lg text-sm text-zinc-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-600/30 focus:border-red-600 transition"
            />
          </div>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-xs font-bold uppercase tracking-wider text-white bg-zinc-950 hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-600 transition duration-150 cursor-pointer"
          >
            Access Dashboard →
          </button>
        </div>
      </form>

      <!-- Security Notice & Login Credentials Info Box -->
      <div class="pt-4 border-t border-zinc-100 bg-zinc-50/70 p-3.5 rounded-lg border border-zinc-200/60 text-[11px] text-zinc-600 space-y-1 font-sans">
        <div class="font-bold text-zinc-800 flex items-center gap-1.5">
          <span>🔒 Authorized Credentials:</span>
        </div>
        <div class="flex items-center justify-between text-zinc-700 font-mono text-[10.5px]">
          <span>Login ID: <strong class="text-zinc-900 bg-zinc-200/80 px-1 py-0.5 rounded">admin</strong></span>
          <span>Password: <strong class="text-zinc-900 bg-zinc-200/80 px-1 py-0.5 rounded">hollywood@8093</strong></span>
        </div>
      </div>

      <div class="text-center">
        <a href="/" class="text-xs text-zinc-500 hover:text-red-600 font-semibold transition">
          ← Return to Hollywood Time Homepage
        </a>
      </div>

    </div>
  </div>
</Layout>
