---
import Layout from '../../layouts/Layout.astro';
import {
  AUTH_COOKIE_NAME,
  AUTH_TOKEN_VALUE,
  verifyAdminCredentials,
  isAuthenticated,
  checkLoginLockout,
  recordFailedAttempt,
  resetLoginAttempts,
  MAX_FAILED_ATTEMPTS,
} from '../../lib/auth';

let errorMessage = '';
let warningMessage = '';

// Check if already authenticated
const existingAuth = Astro.cookies.get(AUTH_COOKIE_NAME)?.value;
if (isAuthenticated(existingAuth)) {
  return Astro.redirect('/admin');
}

const db = (Astro.locals as any)?.runtime?.env?.DB;
const clientIp =
  Astro.request.headers.get('cf-connecting-ip') ||
  Astro.request.headers.get('x-forwarded-for')?.split(',')[0].trim() ||
  '127.0.0.1';

// Check if currently locked out
let lockoutStatus = await checkLoginLockout(clientIp, db);

if (Astro.request.method === 'POST') {
  try {
    if (lockoutStatus.isLocked) {
      errorMessage = `🚫 Access Denied: 10 failed login attempts exceeded. Your account/IP is locked for 24 hours. (Remaining time: approx ${lockoutStatus.remainingHours || 0}h ${lockoutStatus.remainingMinutes || 0}m).`;
    } else {
      const formData = await Astro.request.formData();
      const username = formData.get('username')?.toString() || '';
      const password = formData.get('password')?.toString() || '';

      if (verifyAdminCredentials(username, password)) {
        // Success: Reset failed count immediately
        await resetLoginAttempts(clientIp, db);

        Astro.cookies.set(AUTH_COOKIE_NAME, AUTH_TOKEN_VALUE, {
          path: '/',
          httpOnly: true,
          sameSite: 'lax',
          maxAge: 60 * 60 * 24 * 7, // 7 days
        });
        return Astro.redirect('/admin');
      } else {
        // Record failed attempt
        const failRecord = await recordFailedAttempt(clientIp, db);

        if (failRecord.isLocked) {
          lockoutStatus = {
            isLocked: true,
            remainingHours: 24,
            remainingMinutes: 0,
            failedCount: MAX_FAILED_ATTEMPTS,
          };
          errorMessage = `🚫 Security Lockout Activated: 10 incorrect attempts reached! This portal has been locked for 24 hours.`;
        } else {
          errorMessage = `Incorrect login credentials. Warning: Failed attempt ${failRecord.failedCount} of ${MAX_FAILED_ATTEMPTS}.`;
          warningMessage = `Only ${failRecord.remainingAttempts} attempt(s) remaining before automatic 24-hour lockout!`;
        }
      }
    }
  } catch (err: any) {
    errorMessage = err.message || 'An unexpected error occurred during login.';
  }
}
---

<Layout
  title="Admin Login | Hollywood Time Control Center"
  description="Sign in to the Hollywood Time Operations & Management Hub"
>
  <div class="min-h-[70vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-zinc-50">
    <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-[0_4px_20px_rgba(0,0,0,0.06)] border border-gray-200">
      
      <!-- Brand Masthead Header -->
      <div class="text-center">
        <a href="/" class="inline-block">
          <span class="font-serif font-black text-2xl sm:text-3xl tracking-tight text-zinc-950 uppercase">
            Hollywood<span class="text-hollywood-red ml-1.5 text-xl font-sans inline-block">◆</span>Time
          </span>
        </a>
        <div class="mt-2 flex items-center justify-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-zinc-600">
            Control Center & Editorial Hub
          </span>
        </div>
        <h2 class="mt-4 text-xl font-bold font-serif text-zinc-900">
          Sign In to Admin Portal
        </h2>
        <p class="mt-1 text-xs text-zinc-500 font-sans">
          Manage auto-ingestion, D1 database stories, and Google Search Console indexing.
        </p>
      </div>

      <!-- Lockout Active Warning Banner -->
      {lockoutStatus.isLocked && (
        <div class="p-4 bg-red-100/80 border-2 border-red-500 rounded-xl text-xs text-red-950 font-medium space-y-1.5 shadow-sm">
          <div class="flex items-center gap-2 font-bold text-red-800 text-sm">
            <span>🚫 24-Hour Security Lockout Active</span>
          </div>
          <p class="text-[11.5px] leading-relaxed">
            More than 10 incorrect password attempts were detected. As requested, this login portal is strictly locked for <strong>24 hours</strong> to prevent unauthorized access.
          </p>
          <div class="text-[11px] font-mono text-red-900 pt-1 font-semibold">
            ⏳ Remaining Lock Time: ~{lockoutStatus.remainingHours || 0} Hours {lockoutStatus.remainingMinutes || 0} Mins
          </div>
        </div>
      )}

      <!-- Error / Attempt Alert -->
      {!lockoutStatus.isLocked && errorMessage && (
        <div class="p-3.5 bg-red-50 border border-red-200 rounded-lg text-xs text-red-700 font-medium space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-red-600 font-bold">⚠️</span>
            <span>{errorMessage}</span>
          </div>
          {warningMessage && (
            <p class="text-[11px] font-bold text-red-800 pl-5">
              {warningMessage}
            </p>
          )}
        </div>
      )}

      <!-- Login Form -->
      <form class="mt-6 space-y-5" method="POST">
        <div>
          <label for="username" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1.5">
            Username / Login ID
          </label>
          <div class="relative">
            <input
              id="username"
              name="username"
              type="text"
              required
              disabled={lockoutStatus.isLocked}
              autofocus={!lockoutStatus.isLocked}
              placeholder="e.g. admin"
              class={`w-full px-3.5 py-2.5 bg-zinc-50 border rounded-lg text-sm text-zinc-900 focus:bg-white focus:outline-none transition ${
                lockoutStatus.isLocked
                  ? 'opacity-50 cursor-not-allowed border-zinc-200 bg-zinc-100'
                  : 'border-zinc-300 focus:ring-2 focus:ring-red-600/30 focus:border-red-600'
              }`}
            />
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="password" class="block text-xs font-bold uppercase tracking-wider text-zinc-700">
              Admin Password
            </label>
          </div>
          <div class="relative">
            <input
              id="password"
              name="password"
              type="password"
              required
              disabled={lockoutStatus.isLocked}
              placeholder="••••••••••••"
              class={`w-full px-3.5 py-2.5 bg-zinc-50 border rounded-lg text-sm text-zinc-900 focus:bg-white focus:outline-none transition ${
                lockoutStatus.isLocked
                  ? 'opacity-50 cursor-not-allowed border-zinc-200 bg-zinc-100'
                  : 'border-zinc-300 focus:ring-2 focus:ring-red-600/30 focus:border-red-600'
              }`}
            />
          </div>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            disabled={lockoutStatus.isLocked}
            class={`w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-xs font-bold uppercase tracking-wider text-white transition duration-150 ${
              lockoutStatus.isLocked
                ? 'bg-zinc-400 cursor-not-allowed opacity-60'
                : 'bg-zinc-950 hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-600 cursor-pointer active:scale-98'
            }`}
          >
            {lockoutStatus.isLocked ? '🔒 Portal Locked (24 Hours)' : 'Access Dashboard →'}
          </button>
        </div>
      </form>

      <!-- Security Notice & Login Credentials Info Box -->
      <div class="pt-4 border-t border-zinc-100 bg-zinc-50/70 p-3.5 rounded-lg border border-zinc-200/60 text-[11px] text-zinc-600 space-y-1.5 font-sans">
        <div class="font-bold text-zinc-800 flex items-center justify-between">
          <span class="flex items-center gap-1.5">🛡️ Brute-Force Protection:</span>
          <span class="text-[10px] text-zinc-500 font-mono">Max 10 Attempts</span>
        </div>
        <p class="text-[10.5px] text-zinc-500 leading-normal">
          10 बार से ज्यादा गलत पासवर्ड डालने पर सुरक्षा कारणों से सिस्टम अपने आप <strong>24 घंटे के लिए लॉक</strong> हो जाता है।
        </p>
        <div class="pt-1 flex items-center justify-between text-zinc-700 font-mono text-[10.5px] border-t border-zinc-200/50">
          <span>Login ID: <strong class="text-zinc-900 bg-zinc-200/80 px-1 py-0.5 rounded">admin</strong></span>
          <span>Password: <strong class="text-zinc-900 bg-zinc-200/80 px-1 py-0.5 rounded">hollywood@8093</strong></span>
        </div>
      </div>

      <div class="text-center">
        <a href="/" class="text-xs text-zinc-500 hover:text-red-600 font-semibold transition">
          ← Return to Hollywood Time Homepage
        </a>
      </div>

    </div>
  </div>
</Layout>
