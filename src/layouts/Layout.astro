---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsSchema from '../components/NewsSchema.astro';
import type { Post } from '../lib/types';

interface Props {
  title?: string;
  description?: string;
  currentCategory?: string;
  post?: Post;
  image?: string;
}

const {
  title = 'Hollywood Time | The Definitive Voice of Entertainment, Movies, TV & Awards',
  description = 'Breaking Hollywood news, exclusive interviews, movie reviews, box office tracking, and award season coverage from Hollywood Time.',
  currentCategory,
  post,
  image = post?.featuredImage || 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1200&q=80',
} = Astro.props;

const canonicalUrl = post
  ? `https://www.hollywoodtime.com/news/${post.slug}`
  : currentCategory
  ? `https://www.hollywoodtime.com/${currentCategory}`
  : 'https://www.hollywoodtime.com';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Advanced SEO Robots Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- DNS Prefetch & Preconnect for High Performance -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800&family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,500&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={post ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Hollywood Time" />
    <meta property="og:locale" content="en_US" />

    {post && (
      <>
        <meta property="article:published_time" content={new Date(post.publishedAt).toISOString()} />
        <meta property="article:modified_time" content={new Date(post.updatedAt || post.publishedAt).toISOString()} />
        <meta property="article:section" content={post.categoryLabel} />
        <meta property="article:author" content={post.author.name} />
        {post.tags && post.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hollywoodtime" />
    <meta name="twitter:creator" content="@hollywoodtime" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google News, Standard Sitemap & RSS Autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="Hollywood Time RSS Feed" href="/feed.xml" />
    <link rel="sitemap" type="application/xml" title="Standard Sitemap" href="/sitemap.xml" />
    <link rel="sitemap" type="application/xml" title="Google News Sitemap" href="/sitemap-news.xml" />

    <!-- Structured Data JSON-LD for Google News & Search Console -->
    <NewsSchema post={post} />
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased min-h-screen flex flex-col selection:bg-hollywood-red selection:text-white">
    <Header currentCategory={currentCategory} />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-8 py-6">
      <slot />
    </main>

    <Footer />
  </body>
</html>
