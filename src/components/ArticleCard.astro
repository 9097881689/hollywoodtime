---
import type { Post } from '../lib/types';

interface Props {
  post: Post;
  variant?: 'standard' | 'lead' | 'compact' | 'horizontal';
}

const { post, variant = 'standard' } = Astro.props;

const dateString = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(post.publishedAt));
---

{variant === 'lead' ? (
  <article class="group flex flex-col space-y-4">
    <!-- Featured Image: 10% reduced size with rounded corners -->
    <div class="relative overflow-hidden aspect-[16/9] max-h-[380px] bg-gray-100 rounded-xl shadow-xs">
      <a href={`/news/${post.slug}`}>
        <img
          src={post.featuredImage}
          alt={post.title}
          class="w-full h-full object-cover transform group-hover:scale-105 transition duration-500 ease-out"
          loading="eager"
        />
      </a>
      {post.badge && (
        <span class="absolute top-3 left-3 px-2.5 py-1 text-[11px] font-black uppercase tracking-widest bg-red-600 text-white shadow-md rounded-xs">
          {post.badge}
        </span>
      )}
    </div>

    <div class="space-y-2.5">
      <div class="flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-red-600">
        <a href={`/${post.category}`} class="hover:underline">{post.categoryLabel}</a>
        <span class="text-gray-400">•</span>
        <span class="text-gray-500 font-normal">{post.readingTimeMinutes || '4'} MIN READ</span>
      </div>

      <!-- Premium High-Impact Editorial Heading -->
      <h2 class="text-2xl sm:text-3xl md:text-[34px] font-serif font-bold text-zinc-950 leading-[1.22] tracking-[-0.02em] group-hover:text-red-600 transition-colors duration-200">
        <a href={`/news/${post.slug}`}>{post.title}</a>
      </h2>

      <p class="text-zinc-700 text-sm sm:text-base leading-relaxed font-sans line-clamp-3">
        {post.excerpt}
      </p>

      <!-- Author Byline in Title Case (No Uppercase) -->
      <div class="pt-2 text-xs text-zinc-500 flex items-center space-x-2">
        <span class="font-semibold text-zinc-900 flex items-center gap-1.5 text-xs">
          By {post.author.slug ? (
            <a href={`/author/${post.author.slug}`} class="hover:text-red-600 hover:underline">
              {post.author.name}
            </a>
          ) : (
            post.author.name
          )}
          <span class="w-3.5 h-3.5 rounded-full bg-blue-600 text-white inline-flex items-center justify-center text-[9px] font-black" title="Verified Staff Reporter">✓</span>
        </span>
        <span class="text-gray-300">•</span>
        <time datetime={post.publishedAt} class="text-zinc-500">{dateString}</time>
      </div>
    </div>
  </article>
) : variant === 'compact' ? (
  <article class="group py-3.5 first:pt-0 last:pb-0 flex items-start space-x-3.5">
    <div class="w-20 h-16 sm:w-24 sm:h-18 flex-shrink-0 overflow-hidden bg-gray-100 rounded-lg shadow-xs">
      <a href={`/news/${post.slug}`}>
        <img
          src={post.featuredImage}
          alt={post.title}
          class="w-full h-full object-cover group-hover:scale-105 transition duration-300 ease-out"
          loading="lazy"
        />
      </a>
    </div>
    <div class="flex-1 min-w-0 space-y-1">
      <span class="text-[10px] font-bold uppercase tracking-widest text-red-600">
        {post.categoryLabel}
      </span>
      <h3 class="text-sm font-serif font-bold text-zinc-950 leading-snug group-hover:text-red-600 transition-colors duration-150 line-clamp-2">
        <a href={`/news/${post.slug}`}>{post.title}</a>
      </h3>
      <!-- Author in Title Case -->
      <div class="text-[11px] text-zinc-500 flex items-center gap-1.5 truncate">
        <span class="font-medium text-zinc-700">By {post.author.name}</span>
        <span class="text-zinc-400">•</span>
        <time datetime={post.publishedAt}>{dateString}</time>
      </div>
    </div>
  </article>
) : (
  <article class="group flex flex-col h-full bg-white border border-gray-100 hover:border-gray-300 transition duration-200 p-3 sm:p-4 rounded-xl shadow-[0_1px_4px_rgba(0,0,0,0.04)] hover:shadow-md">
    <!-- 10% less size image with smooth rounded corners -->
    <div class="relative overflow-hidden aspect-[16/10] max-h-[195px] bg-gray-100 mb-3 rounded-lg shadow-xs">
      <a href={`/news/${post.slug}`}>
        <img
          src={post.featuredImage}
          alt={post.title}
          class="w-full h-full object-cover transform group-hover:scale-105 transition duration-300 ease-out"
          loading="lazy"
        />
      </a>
      {post.badge && (
        <span class="absolute top-2 left-2 px-2 py-0.5 text-[10px] font-black uppercase tracking-widest bg-red-600 text-white rounded-xs">
          {post.badge}
        </span>
      )}
    </div>

    <div class="flex-1 flex flex-col justify-between space-y-2">
      <div class="space-y-1.5">
        <div class="text-[11px] font-bold uppercase tracking-widest text-red-600">
          <a href={`/${post.category}`} class="hover:underline">{post.categoryLabel}</a>
        </div>

        <h3 class="text-lg sm:text-[19px] font-serif font-bold text-zinc-950 leading-[1.25] tracking-[-0.01em] group-hover:text-red-600 transition-colors duration-150 line-clamp-2">
          <a href={`/news/${post.slug}`}>{post.title}</a>
        </h3>

        <p class="text-xs sm:text-sm text-zinc-600 line-clamp-2 font-sans leading-relaxed">
          {post.excerpt}
        </p>
      </div>

      <!-- Author Byline in Title Case (No Uppercase) -->
      <div class="pt-3 border-t border-gray-100 flex items-center justify-between text-[11px] text-zinc-500">
        <span class="font-semibold text-zinc-800 flex items-center gap-1.5 truncate max-w-[180px]">
          By {post.author.slug ? (
            <a href={`/author/${post.author.slug}`} class="hover:text-red-600">
              {post.author.name}
            </a>
          ) : (
            post.author.name
          )}
          <span class="w-3 h-3 rounded-full bg-blue-600 text-white inline-flex items-center justify-center text-[7px] font-black flex-shrink-0" title="Verified Staff Reporter">✓</span>
        </span>
        <time datetime={post.publishedAt} class="text-zinc-500 flex-shrink-0">{dateString}</time>
      </div>
    </div>
  </article>
)}
