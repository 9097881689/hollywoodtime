---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showLabel?: boolean;
}

const { size = 'sm' } = Astro.props;

const iconSizes = {
  sm: 'w-3.5 h-3.5',
  md: 'w-4 h-4',
  lg: 'w-5 h-5',
};

const checkSizes = {
  sm: 'w-2 h-2',
  md: 'w-2.5 h-2.5',
  lg: 'w-3 h-3',
};
---

<!-- Only the official verified tick mark per user instruction -->
<span
  class={`inline-flex items-center justify-center rounded-full bg-blue-600 text-white ${iconSizes[size]} shadow-xs align-middle select-none flex-shrink-0`}
  title="Verified Staff Reporter"
>
  <svg class={`${checkSizes[size]} fill-current`} viewBox="0 0 20 20">
    <path
      fill-rule="evenodd"
      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
      clip-rule="evenodd"
    />
  </svg>
</span>
