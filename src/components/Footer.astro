---
const CATEGORIES = [
  { slug: 'movies', label: 'Movies' },
  { slug: 'tv', label: 'TV' },
  { slug: 'music', label: 'Music' },
  { slug: 'awards', label: 'Awards' },
  { slug: 'business', label: 'Business' },
  { slug: 'style', label: 'Style' },
  { slug: 'culture', label: 'Culture' },
];

const LEGAL_LINKS = [
  { name: 'About Us', href: '/about' },
  { name: 'Editorial Standards', href: '/editorial-policy' },
  { name: 'Privacy Policy', href: '/privacy-policy' },
  { name: 'Terms of Service', href: '/terms-of-service' },
  { name: 'Contact & Newsroom', href: '/contact' },
  { name: 'RSS Feed', href: '/feed.xml' },
];
---

<footer class="bg-zinc-950 text-white pt-12 pb-12 border-t border-zinc-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <!-- Editorial Edition & Wire Metadata Ribbon (Moved from Header as requested) -->
    <div class="pb-8 mb-10 border-b border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center space-x-3">
        <span class="px-2.5 py-1 bg-red-600/20 text-red-400 font-bold uppercase tracking-widest text-[10px] rounded-xs border border-red-500/30">
          Independent Wire
        </span>
        <span class="text-zinc-300 font-serif italic text-xs sm:text-sm">
          Film, Television & Arts
        </span>
      </div>

      <div class="flex items-center space-x-4 text-xs text-zinc-400">
        <span class="flex items-center gap-1.5 font-bold text-zinc-200 uppercase tracking-wider text-[11px]">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Global Edition
        </span>
        <span class="text-zinc-600">•</span>
        <span class="text-zinc-400 text-[11px] uppercase tracking-wider font-medium">Updated Hourly</span>
      </div>
    </div>

    <!-- Main Footer Columns -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-zinc-800">
      <!-- Col 1: Brand & Mission (5 cols) -->
      <div class="md:col-span-5 space-y-4">
        <a href="/" class="inline-flex items-center space-x-2 group">
          <span class="inline-block w-3 h-3 bg-red-600 transform rotate-45"></span>
          <span class="text-2xl sm:text-3xl font-black font-serif tracking-tight uppercase text-white group-hover:text-red-500 transition">
            HOLLYWOOD TIME
          </span>
        </a>
        <p class="text-xs sm:text-sm text-zinc-400 font-serif leading-relaxed max-w-sm">
          Hollywood Time is a premier independent digital publication dedicated to authoritative cinema journalism, television criticism, awards tracking, and cultural commentary.
        </p>
        <p class="text-[11px] text-zinc-500">
          Published from Los Angeles, California. Delivered globally.
        </p>
      </div>

      <!-- Col 2: Editorial Departments (3 cols) -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-widest text-zinc-400 border-b border-zinc-800 pb-2">
          Departments
        </h3>
        <ul class="grid grid-cols-2 gap-y-2 text-xs text-zinc-300">
          {CATEGORIES.map((cat) => (
            <li>
              <a href={`/${cat.slug}`} class="hover:text-red-400 transition">
                {cat.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Legal & Standards (4 cols) -->
      <div class="md:col-span-4 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-widest text-zinc-400 border-b border-zinc-800 pb-2">
          Legal & Compliance
        </h3>
        <ul class="space-y-2 text-xs text-zinc-300">
          {LEGAL_LINKS.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition flex items-center gap-1.5">
                <span class="text-zinc-600">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright & Legal Disclaimer -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-zinc-500 gap-4">
      <p>© {new Date().getFullYear()} Hollywood Time. All rights reserved.</p>
      <div class="flex items-center space-x-6 text-[11px]">
        <a href="/privacy-policy" class="hover:text-zinc-300 transition">Privacy Policy</a>
        <a href="/terms-of-service" class="hover:text-zinc-300 transition">Terms of Service</a>
        <a href="/editorial-policy" class="hover:text-zinc-300 transition">Editorial Code</a>
        <a href="/contact" class="hover:text-zinc-300 transition">Newsroom & Corrections</a>
      </div>
    </div>
  </div>
</footer>
