---
import type { Post } from '../lib/types';
import ArticleCard from './ArticleCard.astro';

interface Props {
  category: { slug: string; label: string };
  posts: Post[];
}

const { category, posts } = Astro.props;

// Enforce strictly 3 posts limit as per user requirement
const latest3Posts = posts.slice(0, 3);
---

<section class="py-8 border-b border-zinc-200">
  <!-- Category Header Bar (Premium Magazine Layout) -->
  <div class="flex items-center justify-between border-b-2 border-zinc-950 pb-2.5 mb-6">
    <div class="flex items-center space-x-3">
      <span class="w-2.5 h-6 bg-red-600 inline-block"></span>
      <h2 class="text-xl sm:text-2xl font-serif font-bold text-zinc-950 tracking-tight">
        {category.label}
      </h2>
      <span class="text-xs font-semibold text-zinc-400 uppercase tracking-widest pl-3 border-l border-zinc-300 hidden sm:inline">
        Latest 3 Stories
      </span>
    </div>

    <a
      href={`/${category.slug}`}
      class="text-xs font-bold uppercase tracking-wider text-red-600 hover:text-red-800 transition flex items-center gap-1.5 group"
    >
      <span>Explore {category.label}</span>
      <span class="transform group-hover:translate-x-1 transition duration-150">→</span>
    </a>
  </div>

  <!-- 3 Posts Grid -->
  {latest3Posts.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {latest3Posts.map((post) => (
        <ArticleCard post={post} variant="standard" />
      ))}
    </div>
  ) : (
    <div class="p-8 text-center bg-zinc-50 border border-dashed border-zinc-200 text-zinc-400 text-sm rounded-lg">
      No stories currently in this category. Auto-sync is actively monitoring incoming feeds.
    </div>
  )}
</section>
